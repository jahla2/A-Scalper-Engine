PRIMEXBT_MCP_URL=https://api.primexbt.com/v2/mcp
SCALPER_SYMBOL=XAU/USD
# PRIMEXBT_ACCOUNT_ID=D123456
SCALPER_REQUIRE_DEMO=true

# CLI watcher compatibility.
SCALPER_POLL_SECONDS=2.0

# Web supervisor. Quote updates stay responsive while candle detection is conservative.
SCALPER_QUOTE_POLL_SECONDS=2.0
SCALPER_BAR_POLL_SECONDS=5.0
SCALPER_ACCOUNT_POLL_SECONDS=10.0
SCALPER_MAX_DAILY_DRAWDOWN_PCT=2.0

SCALPER_OAUTH_FILE=.scalper/primexbt_oauth.json
SCALPER_JOURNAL_FILE=logs/signals.jsonl
SCALPER_DATABASE_FILE=.scalper/analysis.db

SCALPER_API_HOST=127.0.0.1
SCALPER_API_PORT=8000
SCALPER_UI_ORIGIN=http://localhost:5173
